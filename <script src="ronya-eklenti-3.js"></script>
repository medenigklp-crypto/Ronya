    if (FG_LIST) return FG_LIST;
    FG_LIST = [
      { cls:'alkol', name:'Metanol', f:'CH4O', build:function(){ return buildAlcohol(1); } },
      { cls:'alkol', name:'Etanol', f:'C2H6O', build:function(){ return buildAlcohol(2); } },
