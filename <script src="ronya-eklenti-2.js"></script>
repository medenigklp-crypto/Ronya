          break;
        }
      }
    }
    // Etiketler
    for (i = 0; i < ssVis.cells.length; i++) {
      var labs = ssVis.cells[i]._labels;
      for (var l = 0; l < labs.length; l++) {
        x.fillStyle = labs[l].c; x.font = labs[l].f; x.textAlign = 'center';
        x.fillText(labs[l].t, labs[l].x, labs[l].y);
