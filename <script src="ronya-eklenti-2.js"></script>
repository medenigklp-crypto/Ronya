                    aucl3:'#fbbf24', pbno3:'#9aa3af', crcl3:'#cbd5e1', znso4:'#d7e2ee', niso4:'#c7f0dd',
                    nacl_m:'#cbd5e1', mgcl2:'#cdd5df', cacl2:'#d5dde6', al2o3:'#d8dee8' };
  function ssGasCol(p){
    if (p.indexOf('Cl') === 0) return '#bde04a';
    if (p.indexOf('O')  === 0) return '#bae6fd';
